# NEXVORA — copy to .env.local and fill in real values. Never commit .env.local.
# Create a Neon project at https://console.neon.tech first, then enable
# Managed Better Auth in the Neon Console (Auth page) and copy the Auth URL.
# See README.md for the full setup steps.

# Neon Postgres — pooled connection (app runtime).
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require

# Neon Postgres — direct (unpooled) connection, used for migrations.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require

# Managed Better Auth (Neon Auth) — branch Auth URL from the Neon Console.
NEON_AUTH_BASE_URL=https://<your-branch-auth-url>.neon.tech

# Cookie secret for Neon Auth — MUST be at least 32 characters.
# Generate one with: openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=<at-least-32-characters>

# Base URL of this app (http://localhost:3000 for local dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000
