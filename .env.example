# NEXVORA — copy to .env.local and fill in real values. Never commit .env.local.
# Create a Supabase project at https://supabase.com/dashboard first.
# See README.md for the full setup steps.

# Public — safe to expose in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, NEVER commit, NEVER paste into chat.
# Used only by server-side API routes for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app (http://localhost:3000 for local dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000
